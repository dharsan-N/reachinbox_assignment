{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Full-Stack Email Scheduler Backend with BullMQ, Redis, PostgreSQL, and Elasticsearch",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
