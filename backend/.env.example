# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Configuration
DATABASE_URL=postgres://reachinbox_user:reachinbox_password@localhost:5432/reachinbox_db
PGUSER=reachinbox_user
PGPASSWORD=reachinbox_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=reachinbox_db

# Redis Configuration (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Worker & Scheduler Configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Ethereal SMTP Credentials (If blank, auto-generated at startup)
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth Configuration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# JWT Secret
JWT_SECRET=super-secret-jwt-key-reachinbox-assignment-2024
